// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "code_lens": "on",
    "completion_detail_alignment": "right",
    "completion_menu_item_kind": "symbol",
    "rounded_selection": false,
    "show_signature_help_after_edits": true,
    "auto_signature_help": true,
    "fast_scroll_sensitivity": 5.0,
    "scroll_beyond_last_line": "off",
    "tab_bar": {
        "show": true,
    },
    "title_bar": {
        "button_layout": "",
    },
    "show_completions_on_input": true,
    "completions": {
            "words_min_length": 0
        },
    "text_rendering_mode": "platform_default",
    "buffer_line_height": "comfortable",
    "buffer_font_weight": 500.0,
    "ui_font_weight": 500.0,
    "ui_font_family": "JetBrainsMono Nerd Font",

    "edit_predictions": {
        "allow_data_collection": "yes",
        "ollama": {
            "api_url": "http://localhost:11434",
        },
        "provider": "copilot",
    },
    "hard_tabs": false,
    "icon_theme": "Zed (Default)",
    "cli_default_open_behavior": "new_window",

    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },

    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },

    "git_panel": {
        "dock": "left",
    },

    "terminal": {
        "copy_on_select": true,
        "font_weight": 500.0,
        "shell": {
            "with_arguments": {
                "program": "",
                "args": [],
                "title_override": null,
            },
        },
        "font_size": 16.0,
        "font_family": "JetBrainsMono Nerd Font",
        "font_fallbacks": ["JetBrainsMonoNL Nerd Font Mono"],
    },

    "base_keymap": "VSCode",

    "minimap": {
        "show": "never",
    },

    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "show_whitespaces": "selection",
    "whitespace_map": {
        // Which characters to show when `show_whitespaces` enabled
        "space": "•",
        "tab": "→",
    },
    "buffer_font_fallbacks": ["JetBrainsMonoNL Nerd Font Mono"],
    "buffer_font_family": "JetBrainsMono Nerd Font",

    "auto_indent_on_paste": true,
    "use_on_type_format": true,

    "wrap_guides": [100],
    "preferred_line_length": 100,
    "soft_wrap": "bounded",

    "tab_size": 4,

    "ui_font_size": 15.0,
    "buffer_font_size": 16.5,
    "inlay_hints": {
        "enabled": false,
        // Toggle certain types of hints on and off, all switched on by default.
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,

        // Whether to show a background for inlay hints (theme `hint.background`)
        "show_background": false, //

        // Time to wait after editing before requesting hints (0 to disable debounce)
        "edit_debounce_ms": 700,
        // Time to wait after scrolling before requesting hints (0 to disable debounce)
        "scroll_debounce_ms": 50,

        // A set of modifiers which, when pressed, will toggle the visibility of inlay hints.
        "toggle_on_modifiers_press": {
            "control": false,
            "shift": false,
            "alt": false,
            "platform": false,
            "function": false,
        },
    },
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Vercel Dark",
    },

    "lsp": {
        "clangd": {
            "binary": {
                "path": "/usr/bin/clangd",
                "arguments": ["--background-index", "--clang-tidy", "--header-insertion=iwyu"],
            },
        },
        "rust-analyzer": {
            "initialization_options": {
                "inlayHints": {
                    "maxLength": null,
                    "lifetimeElisionHints": {
                        "enable": "skip_trivial",
                        "useParameterNames": true,
                    },
                    "closureReturnTypeHints": {
                        "enable": "always",
                    },
                },
            },
        },
    },

    "languages": {
        "Rust": {
            "colorize_brackets": true,
            "completions": {
                "words_min_length": 0
            },
            "format_on_save": "on",
            "inlay_hints": {
                "enabled": true,
            },
        },
        "C++": {
            "prettier": {
                "allowed": false
            },
            "colorize_brackets": true,
            "inlay_hints": {
                "enabled": true
            },
            "completions": {
                "words_min_length": 0
            },
            "format_on_save": "on",
            "tab_size": 4,
        },
    },
}
