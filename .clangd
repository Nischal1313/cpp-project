# clangd configuration for editor IntelliSense (code navigation / diagnostics).
#
# Why this file exists: build/compile_commands.json invokes the ESP-IDF cross
# compiler (xtensa-esp32s3-elf-g++). clangd parses with its own clang frontend, which
# does NOT know that compiler's built-in include directories, so standard headers like
# <atomic>, <cstring> and symbols like std::atomic_flag show up as "file not found" /
# "no type named ... in namespace std". The fixes below tell clangd where the xtensa
# toolchain's C++ standard library lives and let it parse with the native Xtensa target.
#
# NOTE: the paths below are absolute and pinned to the xtensa-esp-elf 13.2.0 toolchain.
# If the toolchain version changes, update the "esp-13.2.0_20240530/.../13.2.0" segments
# (run `xtensa-esp32s3-elf-g++ -xc++ -E -v -` to print the current search dirs).
#
# Alternative (auto-discovering, no hardcoded paths): instead of this file, pass
#   --query-driver=/home/nischal/.espressif/tools/xtensa-esp-elf/**/bin/xtensa-esp32s3-elf-*
# to clangd via your editor's "clangd.arguments" setting; clangd then asks the real
# compiler for its include paths. It is a CLI flag only (not settable here) because it
# runs a binary from the toolchain.

CompileFlags:
  # Parse with clang using LLVM's native Xtensa target (correct 32-bit ABI), instead of
  # the cross-gcc driver clang cannot fully emulate.
  Compiler: clang++
  Add:
    - --target=xtensa
    - -nostdinc++
    # xtensa toolchain libstdc++ + C headers (where <atomic>, <cstring>, ... live):
    - -isystem/home/nischal/.espressif/tools/xtensa-esp-elf/esp-13.2.0_20240530/xtensa-esp-elf/xtensa-esp-elf/include/c++/13.2.0
    - -isystem/home/nischal/.espressif/tools/xtensa-esp-elf/esp-13.2.0_20240530/xtensa-esp-elf/xtensa-esp-elf/include/c++/13.2.0/xtensa-esp-elf/esp32s3
    - -isystem/home/nischal/.espressif/tools/xtensa-esp-elf/esp-13.2.0_20240530/xtensa-esp-elf/xtensa-esp-elf/include/c++/13.2.0/backward
    - -isystem/home/nischal/.espressif/tools/xtensa-esp-elf/esp-13.2.0_20240530/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/13.2.0/include
    - -isystem/home/nischal/.espressif/tools/xtensa-esp-elf/esp-13.2.0_20240530/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/13.2.0/include-fixed
    - -isystem/home/nischal/.espressif/tools/xtensa-esp-elf/esp-13.2.0_20240530/xtensa-esp-elf/xtensa-esp-elf/include
    # benign empty-struct-in-extern-C diagnostic in ESP-IDF headers:
    - -Wno-extern-c-compat
  Remove:
    # xtensa-gcc-only flags that clang's driver rejects:
    - -fno-shrink-wrap
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -mlongcalls
    - -mtext-section-literals
    - -march=*
    - -mabi=*
    - -mcpu=*
